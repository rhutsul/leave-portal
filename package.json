{
  "name": "2026-quitcode-06-project-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "spec:validate": "openspec validate --all --strict",
    "spec:check": "node scripts/check-spec.mjs",
    "ac:coverage": "node scripts/check-ac-coverage.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "users:demo": "node --env-file=.env.local scripts/create-demo-users.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:boundary": "node scripts/check-server-boundary.mjs",
    "check:ui": "node scripts/check-ui-primitives.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "uat": "node scripts/uat/run.mjs",
    "uat:nc": "node scripts/uat/run.mjs --negative-controls",
    "uat:review": "node scripts/uat/review.mjs && node scripts/uat/report.mjs",
    "gates": "npm run lint && npm run typecheck && fallow audit --base origin/main",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "mutation:ts": "stryker run",
    "mutation:sql": "node scripts/mutation-check.mjs --kind sql",
    "proof-pack:table": "node scripts/proof-pack-table.mjs",
    "eval": "vitest run -c vitest.eval.config.mts",
    "ai:models": "node scripts/free-models.mjs",
    "ai:quota": "node --env-file-if-exists=.env.local scripts/quota.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.172",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.2",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-playwright": "2.12.2",
    "fallow": "3.42.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
